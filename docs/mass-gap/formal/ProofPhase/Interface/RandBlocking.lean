import ProofPhase.Interface.MeasBlocking

/-!
# Randomized blockings: the assembly for a blocking that uses independent noise

A *randomized blocking* from `(ℤ/Nℤ)^d` to `(ℤ/Mℤ)^d` is a measurable map
`B : (fine configuration) × Ω → (coarse configuration)` together with a probability space `(Ω, P)` of auxiliary noise
(for M1: a swallowed coarse bond gets an independent Haar value). The **block law** is the pushforward of `μ ⊗ P`.

Everything that the gap and transfer path of the assembly does with the blocking is a statement about the coarse
observables `f ∘ B` and about conditional expectations given the sigma-algebra generated by `B`. All of this is stated on the
product space `(fine configuration) × Ω` with the measure `μ ⊗ P`; fine observables enter as `F ∘ fst`. Their integrals equal
the integrals over the fine measure `μ` (`integral_comp_fst`), which is how the torus correlation `wcorr` is recovered.

Where determinism could have mattered: the proof of the torus decay uses the blocking only through (i) the map and its
measurability and (ii) `cov_transfer`, which is stated for an arbitrary probability space and measurable map. So it needs
no determinism, and the port below changes only the ambient space and measure. A deterministic `MeasBlocking` is the case
`Ω = Unit` (`MeasBlocking.toRand`), and the block law, the gap statements and the pushforward all reduce to the old ones.
-/

open MeasureTheory Finset Filter Topology AreaLaw.Concrete OneScale OneScale.Gauge OneScale.LinkDist
  OneScale.TimeShift OneScale.CubeChain Positivity ProofPhase.Existence ProofPhase.RouteA ProofPhase.Torus
  ProofPhase.H1 ProofPhase.Certified ProofPhase.V3 ProofPhase.V4

open scoped Classical

set_option linter.unusedSectionVars false

noncomputable section

namespace ProofPhase.Interface

/-- **A randomized blocking** from `(ℤ/Nℤ)^d` to `(ℤ/Mℤ)^d`: a probability space of auxiliary noise and a measurable map of
(fine configuration, noise) to the coarse configuration. -/
structure RandBlocking (G : Type*) [Group G] [MeasurableSpace G] (d N M : ℕ) [NeZero d] [NeZero N] [NeZero M] where
  /-- The noise space. -/
  Ω : Type
  [mΩ : MeasurableSpace Ω]
  /-- The law of the noise. -/
  P : Measure Ω
  [prob : IsProbabilityMeasure P]
  /-- The blocking map. -/
  B : GaugeConnection G d N × Ω → GaugeConnection G d M
  meas : Measurable B

attribute [instance] RandBlocking.mΩ RandBlocking.prob

/-- A deterministic measurable blocking is a randomized one with trivial noise. -/
def MeasBlocking.toRand {G : Type*} [Group G] [MeasurableSpace G] {d N M : ℕ} [NeZero d] [NeZero N] [NeZero M]
    (P : MeasBlocking G d N M) : RandBlocking G d N M where
  Ω := Unit
  P := Measure.dirac ()
  B := fun p => P.B p.1
  meas := P.meas.comp measurable_fst

/-- A randomized blocking family: at every level and volume a randomized blocking of the fine torus onto the coarse one. -/
abbrev RandBlockingFamily (T : Tuning) := ∀ k j, RandBlocking SU2 4 (T.side k j) (coarseSide j)

/-- Forget determinism-by-construction: view a measurable family as a randomized one. -/
def measFamilyToRand {T : Tuning} (B : MeasBlockingFamily T) : RandBlockingFamily T := fun k j => (B k j).toRand

/-- The joint law of fine configuration and noise at level `k`, volume `j`: `ym ⊗ P`. -/
abbrev randJointLaw (T : Tuning) (B : RandBlockingFamily T) (k j : ℕ) :
    Measure (GaugeConnection SU2 4 (T.side k j) × (B k j).Ω) :=
  (T.ym k j).prod (B k j).P

instance ymProbInst (T : Tuning) (k j : ℕ) : IsProbabilityMeasure (T.ym k j) := UV.ymProb T k j

instance randJointLaw_prob (T : Tuning) (B : RandBlockingFamily T) (k j : ℕ) :
    IsProbabilityMeasure (randJointLaw T B k j) := by
  infer_instance

/-- **The block law:** the pushforward of `ym ⊗ P` under the blocking map. -/
def randBlockedLaw (T : Tuning) (B : RandBlockingFamily T) (k j : ℕ) :
    Measure (GaugeConnection SU2 4 (coarseSide j)) :=
  (randJointLaw T B k j).map (B k j).B

/-! ## Integrals over the product -/

/-- A fine observable has the same integral over `μ ⊗ P` as over `μ`. -/
theorem integral_comp_fst {X Ω : Type*} [MeasurableSpace X] [MeasurableSpace Ω] (μ : Measure X) [IsProbabilityMeasure μ]
    (P : Measure Ω) [IsProbabilityMeasure P] {h : X → ℝ} (hh : Measurable h) :
    ∫ p, h p.1 ∂(μ.prod P) = ∫ x, h x ∂μ := by
  have hm : (μ.prod P).map Prod.fst = μ := by simp [Measure.map_fst_prod]
  have := integral_map (μ := μ.prod P) measurable_fst.aemeasurable (f := h) (by rw [hm]; exact hh.aestronglyMeasurable)
  rw [hm] at this
  exact this.symm

/-- With trivial noise the joint law is the fine law (via the section `x ↦ (x, ())`). -/
theorem prod_dirac_unit_eq_map {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ] :
    μ.prod (Measure.dirac ()) = μ.map (fun x => (x, ())) := by
  rw [Measure.prod_dirac]

theorem integral_prod_dirac_unit {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ] (h : X × Unit → ℝ) :
    ∫ p, h p ∂(μ.prod (Measure.dirac ())) = ∫ x, h (x, ()) ∂μ := by
  rw [prod_dirac_unit_eq_map]
  exact (measurableEmbedding_prod_mk_right (β := X) ()).integral_map h

/-- With trivial noise the block law is the old one. -/
theorem randBlockedLaw_measFamilyToRand {T : Tuning} (B : MeasBlockingFamily T) (k j : ℕ) :
    randBlockedLaw T (measFamilyToRand B) k j = measBlockedLaw T B k j := by
  unfold randBlockedLaw randJointLaw measBlockedLaw measFamilyToRand MeasBlocking.toRand
  simp only
  have hg : Measurable (fun p : GaugeConnection SU2 4 (T.side k j) × Unit => (B k j).B p.1) :=
    (B k j).meas.comp measurable_fst
  have hf : Measurable (fun x : GaugeConnection SU2 4 (T.side k j) => (x, ())) :=
    measurable_id.prodMk measurable_const
  rw [prod_dirac_unit_eq_map, Measure.map_map hg hf]
  rfl

/-- **Covariances pass through a conditional expectation on the joint space** (`cov_transfer` for `μ ⊗ P`, with the fine
observables entering as `F ∘ fst`). The conclusion is a statement about the fine measure `μ`. -/
theorem cov_transfer_rand {X Ω Y : Type*} [MeasurableSpace X] [MeasurableSpace Ω] [MeasurableSpace Y]
    (μ : Measure X) [IsProbabilityMeasure μ] (P : Measure Ω) [IsProbabilityMeasure P] {Φ : X × Ω → Y}
    (hΦ : Measurable Φ) {F G : X → ℝ} {f g : Y → ℝ} (hF : Measurable F) (hG : Measurable G)
    (hF1 : ∀ x, |F x| ≤ 1) (hG1 : ∀ x, |G x| ≤ 1) (hf : Measurable f) (hg : Measurable g)
    (hf1 : ∀ y, |f y| ≤ 1) (hg1 : ∀ y, |g y| ≤ 1) {ε : ℝ}
    (hEF : ∫ p, |(μ.prod P)[(fun q => F q.1) | MeasurableSpace.comap Φ inferInstance] p - f (Φ p)| ∂(μ.prod P) ≤ ε)
    (hEG : ∫ p, |(μ.prod P)[(fun q => G q.1) | MeasurableSpace.comap Φ inferInstance] p - g (Φ p)| ∂(μ.prod P) ≤ ε)
    (hdec : |∫ p, F p.1 * G p.1 ∂(μ.prod P) - ∫ p, (μ.prod P)[(fun q => F q.1) | MeasurableSpace.comap Φ inferInstance] p *
        (μ.prod P)[(fun q => G q.1) | MeasurableSpace.comap Φ inferInstance] p ∂(μ.prod P)| ≤ ε) :
    |∫ x, F x * G x ∂μ - (∫ x, F x ∂μ) * ∫ x, G x ∂μ| ≤
      |∫ p, f (Φ p) * g (Φ p) ∂(μ.prod P) - (∫ p, f (Φ p) ∂(μ.prod P)) * ∫ p, g (Φ p) ∂(μ.prod P)| + 5 * ε := by
  have h := cov_transfer (μ.prod P) hΦ (hF.comp measurable_fst) (hG.comp measurable_fst) (fun p => hF1 _)
    (fun p => hG1 _) hf hg hf1 hg1 hEF hEG hdec
  have e1 := integral_comp_fst μ P (h := fun x => F x * G x) (hF.mul hG)
  have e2 := integral_comp_fst μ P hF
  have e3 := integral_comp_fst μ P hG
  simp only [Function.comp] at h
  rw [e1, e2, e3] at h
  exact h

/-! ## The statements for a randomized family (same shape, integrals over the joint law) -/

/-- `BlockGapUnifW` for a randomized family. -/
def RandBlockGapUnifW (T : Tuning) (B : RandBlockingFamily T) (lam : ℝ) : Prop :=
  ∃ C : ℝ, 0 ≤ C ∧ ∃ k₀ : ℕ, ∀ k, k₀ ≤ k → ∀ (j : ℕ)
    (f g : GaugeConnection SU2 4 (coarseSide j) → ℝ) (A Sg : Finset (LatticeLink 4 (coarseSide j)))
    (vf : LatticeLink 4 (coarseSide j) → ℝ) (Lg R : ℝ),
    BM f → BM g → DepOn f A → DepOn g Sg → OscBound f vf → 0 ≤ Lg → LipBound geodSU2 g (fun _ => Lg) →
    (∀ x ∈ A, ∀ y ∈ Sg, R ≤ linkDist x y) →
    |∫ p, f ((B k j).B p) * g ((B k j).B p) ∂(randJointLaw T B k j) -
        (∫ p, f ((B k j).B p) ∂(randJointLaw T B k j)) * ∫ p, g ((B k j).B p) ∂(randJointLaw T B k j)| ≤
      C * (∑ a ∈ A, vf a) * Lg * Real.exp (-(lam * R))

/-- `BlockGapBddW` for a randomized family. -/
def RandBlockGapBddW (T : Tuning) (B : RandBlockingFamily T) (lam : ℝ) : Prop :=
  ∃ C : ℝ, 0 ≤ C ∧ ∃ k₀ : ℕ, ∀ k, k₀ ≤ k → ∀ (j : ℕ)
    (f g : GaugeConnection SU2 4 (coarseSide j) → ℝ) (A Sg : Finset (LatticeLink 4 (coarseSide j)))
    (vf : LatticeLink 4 (coarseSide j) → ℝ) (Lg R : ℝ),
    Measurable f → Measurable g → (∀ V, |f V| ≤ 1) → (∀ V, |g V| ≤ 1) → DepOn f A → DepOn g Sg →
    OscBound f vf → 0 ≤ Lg → LipBound geodSU2 g (fun _ => Lg) → 0 ≤ R →
    (∀ x ∈ A, ∀ y ∈ Sg, R ≤ linkDist x y) →
    |∫ p, f ((B k j).B p) * g ((B k j).B p) ∂(randJointLaw T B k j) -
        (∫ p, f ((B k j).B p) ∂(randJointLaw T B k j)) * ∫ p, g ((B k j).B p) ∂(randJointLaw T B k j)| ≤
      C * (1 + ∑ a ∈ A, vf a) * (1 + Lg) * Real.exp (-(lam * R))

/-- `ObsTransferPhysTW` for a randomized family. The fine observables `F, G` enter the joint space as `F ∘ fst`,
`G ∘ fst`; the conditional expectations are given the sigma-algebra generated by the blocking map on the joint space. -/
def RandObsTransferPhysTW (T : Tuning) (B : RandBlockingFamily T) : Prop :=
  ∃ m : ℝ, 0 < m ∧ ∀ R : ℝ, ∃ c K : ℝ, 0 ≤ c ∧ 0 ≤ K ∧ ∃ k₀ : ℕ, ∀ k, k₀ ≤ k → ∀ (j : ℕ)
    (F G : GaugeConnection SU2 4 (T.side k j) → ℝ) (A₀ B₀ : Finset (LatticeLink 4 (T.side k j))) (D : ℝ), 0 ≤ D →
    Measurable F → Measurable G → (∀ U, |F U| ≤ 1) → (∀ U, |G U| ≤ 1) → GaugeInvariant F → GaugeInvariant G →
    DepOn F A₀ → DepOn G B₀ → PhysExtent T k A₀ R → PhysExtent T k B₀ R →
    (∀ e ∈ A₀, ∀ e' ∈ B₀, D ≤ T.a k * timeDist e e') →
    ∃ (f g : GaugeConnection SU2 4 (coarseSide j) → ℝ) (A' B' : Finset (LatticeLink 4 (coarseSide j))),
      Measurable f ∧ Measurable g ∧ (∀ V, |f V| ≤ 1) ∧ (∀ V, |g V| ≤ 1) ∧ DepOn f A' ∧ DepOn g B' ∧
      (∃ vf : LatticeLink 4 (coarseSide j) → ℝ, OscBound f vf ∧ ∑ a ∈ A', vf a ≤ 2 * K * (1 + D / T.L₁) ^ 4) ∧
      LipBound geodSU2 g (fun _ => K) ∧
      (∀ x ∈ A', ∀ y ∈ B', D / 2 ≤ T.L₁ * linkDist x y) ∧
      ∫ p, |condExp (MeasurableSpace.comap (B k j).B inferInstance) (randJointLaw T B k j) (fun q => F q.1) p -
          f ((B k j).B p)| ∂(randJointLaw T B k j) ≤ c * Real.exp (-(m * D)) ∧
      ∫ p, |condExp (MeasurableSpace.comap (B k j).B inferInstance) (randJointLaw T B k j) (fun q => G q.1) p -
          g ((B k j).B p)| ∂(randJointLaw T B k j) ≤ c * Real.exp (-(m * D)) ∧
      |∫ p, F p.1 * G p.1 ∂(randJointLaw T B k j) -
          ∫ p, condExp (MeasurableSpace.comap (B k j).B inferInstance) (randJointLaw T B k j) (fun q => F q.1) p *
            condExp (MeasurableSpace.comap (B k j).B inferInstance) (randJointLaw T B k j) (fun q => G q.1) p
            ∂(randJointLaw T B k j)|
        ≤ c * Real.exp (-(m * D))

/-! ## Deterministic special case: the gap statements with trivial noise are the old ones -/

theorem randBlockGapBddW_measFamilyToRand_iff {T : Tuning} (B : MeasBlockingFamily T) (lam : ℝ) :
    RandBlockGapBddW T (measFamilyToRand B) lam ↔ MeasBlockGapBddW T B lam := by
  unfold RandBlockGapBddW MeasBlockGapBddW randJointLaw measFamilyToRand MeasBlocking.toRand
  simp only [integral_prod_dirac_unit]

theorem randBlockGapUnifW_measFamilyToRand_iff {T : Tuning} (B : MeasBlockingFamily T) (lam : ℝ) :
    RandBlockGapUnifW T (measFamilyToRand B) lam ↔ MeasBlockGapUnifW T B lam := by
  unfold RandBlockGapUnifW MeasBlockGapUnifW randJointLaw measFamilyToRand MeasBlocking.toRand
  simp only [integral_prod_dirac_unit]

/-! ## The gap statements -/

/-- The homogeneous block gap implies the bounded one, for a randomized family. -/
theorem randBlockGapBddW_of_unifW {T : Tuning} {B : RandBlockingFamily T} {lam : ℝ}
    (h : RandBlockGapUnifW T B lam) : RandBlockGapBddW T B lam := by
  obtain ⟨C, hC, k₀, H⟩ := h
  refine ⟨C, hC, k₀, fun k hk j f g A Sg vf Lg R mf mg bf bg hfA hgS hvf hLg hlip _ hR => ?_⟩
  exact (H k hk j f g A Sg vf Lg R ⟨mf, 1, bf⟩ ⟨mg, 1, bg⟩ hfA hgS hvf hLg hlip hR).trans
    (homog_le_bdd hC (sum_osc_nonneg hvf A) hLg (Real.exp_pos _).le)

/-- **The v4 cut with the bounded infrared input, for a randomized blocking family.** The proof of
`measTorusDecayLoc_of_blockGapBddW` with `cov_transfer` applied on the joint space `ym ⊗ P`; nothing uses determinism of the
blocking. -/
theorem randTorusDecayLoc_of_blockGapBddW {T : Tuning} (B : RandBlockingFamily T) {lam : ℝ} (hlam : 0 < lam)
    (hB : RandBlockGapBddW T B lam) (h3 : RandObsTransferPhysTW T B) : TorusDecayLoc T.toV := by
  obtain ⟨C, hC, k₀, hgap⟩ := hB
  obtain ⟨m, hm, htrP⟩ := h3
  have hL1 := T.L₁_pos
  set a := lam / 4
  have ha : 0 < a := by positivity
  set m' := min (lam / (4 * T.L₁)) m
  have hm' : 0 < m' := lt_min (by positivity) hm
  refine ⟨m', hm', fun s R => ?_⟩
  obtain ⟨c, K, hc, hK, k₁, htr⟩ := htrP (R + T.L₁)
  refine ⟨max k₀ k₁, C * (1 + 2 * K) * (1 + K) * (24 / a ^ 4 * Real.exp a) + 5 * c, by positivity,
    fun k hk Vb j O hO n hn => ?_⟩
  have hk₀ : k₀ ≤ k := (le_max_left _ _).trans hk
  have hk₁ : k₁ ≤ k := (le_max_right _ _).trans hk
  obtain ⟨hdA, hdB, -, -, -⟩ := slab_transfer_data T O hn
  have hsepT := slab_time_sep T O hn
  have hak := T.a_pos k
  have haL : T.a k ≤ T.L₁ := div_le_self hL1.le (by exact_mod_cast T.ℓ_pos k)
  have eA : PhysExtent T k (((O.supp k j) ∩ timeSlab 0 (T.thick k s)).image (shiftLink (n : ZMod (T.side k j))))
      (R + T.L₁) := by
    intro e he e' he'
    obtain ⟨l, hl, rfl⟩ := Finset.mem_image.1 he
    obtain ⟨l', hl', rfl⟩ := Finset.mem_image.1 he'
    rw [linkDist_shiftLink]
    have : T.a k * linkDist l l' ≤ R := hO k j l (Finset.mem_inter.1 hl).1 l' (Finset.mem_inter.1 hl').1
    linarith
  have eB : PhysExtent T k (((O.supp k j) ∩ timeSlab 0 (T.thick k s)).image mirrorLink) (R + T.L₁) := by
    intro e he e' he'
    obtain ⟨l, hl, rfl⟩ := Finset.mem_image.1 he
    obtain ⟨l', hl', rfl⟩ := Finset.mem_image.1 he'
    have h1 : T.a k * linkDist l l' ≤ R := hO k j l (Finset.mem_inter.1 hl).1 l' (Finset.mem_inter.1 hl').1
    have h2 := mul_le_mul_of_nonneg_left (linkDist_mirrorLink_le l l') hak.le
    nlinarith
  set D := (n : ℝ) * T.a k
  have hD : 0 ≤ D := by positivity
  have hFm := (O.meas k j).comp (measurable_tShift (G := SU2) (d := 4) (N := T.side k j) (n : ZMod (T.side k j)))
  have hGm := (O.meas k j).comp (measurePreserving_thetaConn (G := SU2) (d := 4) (N := T.side k j)).measurable
  obtain ⟨f, g, A', B', mf, mg, bf, bg, dfA, dgB, ⟨vf, hvf, hsv⟩, hlip, hsep', hEF, hEG, hdec⟩ :=
    htr k hk₁ j _ _ _ _ D hD hFm hGm (fun U => O.bdd k j _) (fun U => O.bdd k j _)
      (gaugeInvariant_tShift (O.gauge k j) _) (gaugeInvariant_thetaConn (O.gauge k j)) hdA hdB eA eB hsepT
  have hx : 0 ≤ D / T.L₁ := by positivity
  -- the block covariance, by the bounded infrared input
  have hR' : ∀ x ∈ A', ∀ y ∈ B', D / (2 * T.L₁) ≤ linkDist x y := by
    intro x hx' y hy
    rw [div_le_iff₀ (by positivity)]
    have := hsep' x hx' y hy
    nlinarith
  have hblk := hgap k hk₀ j f g A' B' vf K (D / (2 * T.L₁)) mf mg bf bg dfA dgB hvf hK hlip (by positivity) hR'
  -- the transfer, on the joint space
  haveI := UV.ymProb T k j
  have htr' := cov_transfer_rand (T.ym k j) (B k j).P (B k j).meas hFm hGm
    (fun p => O.bdd k j _) (fun p => O.bdd k j _) mf mg bf bg hEF hEG hdec
  have hw : |T.wcorr k j (O.F k j) n| ≤
      C * (1 + ∑ a ∈ A', vf a) * (1 + K) * Real.exp (-(lam * (D / (2 * T.L₁)))) +
        5 * (c * Real.exp (-(m * D))) := by
    unfold Tuning.wcorr corr
    exact htr'.trans (by linarith)
  -- constants
  have hY1 : 1 ≤ (1 + D / T.L₁) ^ 4 := one_le_pow₀ (by linarith)
  have h1S : 1 + ∑ a ∈ A', vf a ≤ (1 + 2 * K) * (1 + D / T.L₁) ^ 4 := by nlinarith
  set Kc := C * (1 + 2 * K) * (1 + K) with hKcdef
  have hKc : 0 ≤ Kc := by positivity
  have hstep : C * (1 + ∑ a ∈ A', vf a) * (1 + K) ≤ Kc * (1 + D / T.L₁) ^ 4 := by
    have h1 := mul_le_mul_of_nonneg_left h1S hC
    have h2 := mul_le_mul_of_nonneg_right h1 (by linarith : (0 : ℝ) ≤ 1 + K)
    calc C * (1 + ∑ a ∈ A', vf a) * (1 + K) ≤ C * ((1 + 2 * K) * (1 + D / T.L₁) ^ 4) * (1 + K) := h2
      _ = Kc * (1 + D / T.L₁) ^ 4 := by rw [hKcdef]; ring
  have hpoly := poly_exp_le ha hx
  have e1' : lam * (D / (2 * T.L₁)) = 2 * a * (D / T.L₁) := by simp only [a]; field_simp; ring
  have e2' : a * (D / T.L₁) = lam / (4 * T.L₁) * D := by simp only [a]; field_simp
  have hE1 : Real.exp (-(lam / (4 * T.L₁) * D)) ≤ Real.exp (-(m' * D)) :=
    Real.exp_le_exp.mpr (by nlinarith [min_le_left (lam / (4 * T.L₁)) m])
  have hE2 : Real.exp (-(m * D)) ≤ Real.exp (-(m' * D)) :=
    Real.exp_le_exp.mpr (by nlinarith [min_le_right (lam / (4 * T.L₁)) m])
  show |T.wcorr k j (O.F k j) n| ≤ _
  calc |T.wcorr k j (O.F k j) n|
      ≤ C * (1 + ∑ a ∈ A', vf a) * (1 + K) * Real.exp (-(lam * (D / (2 * T.L₁)))) +
          5 * (c * Real.exp (-(m * D))) := hw
    _ ≤ Kc * (1 + D / T.L₁) ^ 4 * Real.exp (-(2 * a * (D / T.L₁))) + 5 * c * Real.exp (-(m' * D)) := by
        rw [e1']
        have h5 : c * Real.exp (-(m * D)) ≤ c * Real.exp (-(m' * D)) := mul_le_mul_of_nonneg_left hE2 hc
        have h6 := mul_le_mul_of_nonneg_right hstep (Real.exp_pos (-(2 * a * (D / T.L₁)))).le
        linarith
    _ = Kc * ((1 + D / T.L₁) ^ 4 * Real.exp (-(2 * a * (D / T.L₁)))) + 5 * c * Real.exp (-(m' * D)) := by ring
    _ ≤ Kc * (24 / a ^ 4 * Real.exp a * Real.exp (-(a * (D / T.L₁)))) + 5 * c * Real.exp (-(m' * D)) := by
        gcongr
    _ = Kc * (24 / a ^ 4 * Real.exp a) * Real.exp (-(lam / (4 * T.L₁) * D)) + 5 * c * Real.exp (-(m' * D)) := by
        rw [e2']; ring
    _ ≤ Kc * (24 / a ^ 4 * Real.exp a) * Real.exp (-(m' * D)) + 5 * c * Real.exp (-(m' * D)) := by gcongr
    _ = (Kc * (24 / a ^ 4 * Real.exp a) + 5 * c) * Real.exp (-(m' * (n * T.a k))) := by ring

/-- **Assembly v4 for a randomized blocking family** (bounded infrared input): the conclusions of
`yang_mills_assembly_v4_bdd`, for a blocking that is a measurable function of the fine configuration and independent
auxiliary noise. -/
theorem yang_mills_assembly_v4_bdd_rand {T : Tuning} (hL : OnLCP' T) (hN : NonTrivial T) (B : RandBlockingFamily T)
    {lam : ℝ} (hlam : 0 < lam) (hIR : RandBlockGapBddW T B lam) (hUV : RandObsTransferPhysTW T B) :
    TorusDecayLoc T.toV ∧ MassGapLoc T ∧ MassGapMFLoc T.toV ∧ LimitRP T ∧ NonTrivial T := by
  have hT := randTorusDecayLoc_of_blockGapBddW B hlam hIR hUV
  obtain ⟨hVF, hMF⟩ := bothOrdersLoc_of_torusDecayLoc hL.tendsto_a hT
  exact ⟨hT, hVF, hMF, limitRP T, hN⟩

/-- **Assembly v4 for a randomized blocking family** (homogeneous infrared input). -/
theorem yang_mills_assembly_v4_rand {T : Tuning} (hL : OnLCP' T) (hN : NonTrivial T) (B : RandBlockingFamily T)
    {lam : ℝ} (hlam : 0 < lam) (hIR : RandBlockGapUnifW T B lam) (hUV : RandObsTransferPhysTW T B) :
    TorusDecayLoc T.toV ∧ MassGapLoc T ∧ MassGapMFLoc T.toV ∧ LimitRP T ∧ NonTrivial T :=
  yang_mills_assembly_v4_bdd_rand hL hN B hlam (randBlockGapBddW_of_unifW hIR) hUV

/-- The open inputs of version 4 for a randomized blocking family. -/
structure RandOpenInputsV4 (T : Tuning) : Prop where
  lcp : OnLCP' T
  nontrivial : NonTrivial T
  layers : ∃ (B : RandBlockingFamily T) (lam : ℝ), 0 < lam ∧ RandBlockGapBddW T B lam ∧ RandObsTransferPhysTW T B

theorem yang_mills_assembly_v4_inputs_rand {T : Tuning} (P : RandOpenInputsV4 T) :
    TorusDecayLoc T.toV ∧ MassGapLoc T ∧ MassGapMFLoc T.toV ∧ LimitRP T ∧ NonTrivial T := by
  obtain ⟨B, lam, hlam, hIR, hUV⟩ := P.layers
  exact yang_mills_assembly_v4_bdd_rand P.lcp P.nontrivial B hlam hIR hUV

/-! ## Constructors for randomized blockings -/

/-- A blocking through an intermediate state `X` that depends on the fine configuration and the noise, with a measurable
SU(2) encoding. -/
def RandBlocking.viaState {N M : ℕ} [NeZero N] [NeZero M] (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] {X : Type*} [MeasurableSpace X] (φ : GaugeConnection SU2 4 N × Ω → X) (hφ : Measurable φ)
    (enc : X → GaugeConnection SU2 4 M) (henc : Measurable enc) : RandBlocking SU2 4 N M :=
  ⟨Ω, P, enc ∘ φ, henc.comp hφ⟩

/-- The block law of such a blocking is the encoding of the law of the block state under `μ ⊗ P`. -/
theorem randBlockedLaw_viaState {N M : ℕ} [NeZero N] [NeZero M] (Ω : Type) [MeasurableSpace Ω] (P : Measure Ω)
    [IsProbabilityMeasure P] {X : Type*} [MeasurableSpace X] (μ : Measure (GaugeConnection SU2 4 N))
    (φ : GaugeConnection SU2 4 N × Ω → X) (hφ : Measurable φ) (enc : X → GaugeConnection SU2 4 M)
    (henc : Measurable enc) :
    (μ.prod P).map (RandBlocking.viaState Ω P φ hφ enc henc).B = ((μ.prod P).map φ).map enc :=
  (Measure.map_map henc hφ).symm

end ProofPhase.Interface
