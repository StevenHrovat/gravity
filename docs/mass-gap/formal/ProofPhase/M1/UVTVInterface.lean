import ProofPhase.M1.UVTVCov
import ProofPhase.Interface.SpectralUpgrade

/-!
# The interface: OS-norm density and the gap for local observables

**Probability half (proved).** `REVIEW3-RESPONSE.md` 13.4 splits the OS norm of the remainder `R = F - E[F | 𝓗]` into
(A) and (B). In abstract form, for bounded `a, b`, sub-σ-algebras `𝓗_a, 𝓗_b ≤ 𝓕 ≤ m0`:

* `os_cross_le`: `|E[(a - E[a | 𝓗_a])(b - E[b | 𝓗_b])]| ≤ E|ccov 𝓕 a b| + 2 E|E[a | 𝓕] - E[a | 𝓗_a]|`.

With `a = θF`, `b = F`, `𝓕 = 𝓕_ℓ` the block state, `𝓗` the block state near `supp F` (and `θ𝓗` near `θ supp F`),
the left side is `‖F - f_ℓ‖²_OS` with `f_ℓ = E[F | 𝓗]`; the first term on the right is (B) (`statementB`), the second
is (A) (module 2 at the top scale).

**Hilbert-space half (proved, on an abstract OS space).**

* `OSData`: the named hypothesis where the reconstruction enters. A real inner product space `H`, a linear map `Φ`
  from the observables into `H`, and the OS form `Q` with `‖Φ u‖² = Q u` (`Q u = E[θu · u]`; reflection positivity is
  what makes it a square norm). The transfer operator `T` (symmetric, positive) and the closed invariant subspace
  `H0` (the vacuum complement generated by block observables) are further named data.
* `mem_closure_of_os`: if `Q(F - f) ≤ ε` is achievable with block observables `f` for every `ε > 0`, then `Φ F` lies
  in the closure of the block vectors.
* `mem_closure_of_tendsto`: the same from a sequence `f_ℓ` with `Q(F - f_ℓ) → 0` (UV-TV's form: `ℓ → 0` at fixed `t`).
* `gap_of_density`: with decay `⟪G, T^n G⟫ ≤ C_G e^{-mn}` for block vectors (the block-level gap, constants depending on
  the observable), every observable in the OS closure of the block observables has
  `⟪Φ F, T^n Φ F⟫ ≤ e^{-mn} ‖Φ F‖²`, by `ProofPhase.Interface.spectral_upgrade`.
* `gap_of_UVTV`: the two halves together: if for every `ℓ` the OS norm `Q(F - f_ℓ)` is bounded by a (B)-term plus twice an
  (A)-term, and both tend to `0`, then `F` has the gap at the block rate.

**What is not formalised** (stops at a named hypothesis): the construction of `OSData` from the infinite-volume
continuum limit (OS reconstruction: the quotient by null vectors, the completion, `T` from the time translation), the
`T`-invariance of the block closure `H0`, and the identification `Q(F - f_ℓ) = E[(θF - θf_ℓ)(F - f_ℓ)]` with the
probability expression of `os_cross_le` (θ measure preserving with `θ𝓗 ≤ 𝓕_ℓ`).
-/

open MeasureTheory Finset Filter Topology

open scoped RealInnerProductSpace

set_option linter.unusedSectionVars false

noncomputable section

namespace ProofPhase.M1.UVTV

/-! ### The probability half -/

section Prob

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]

/-- `E[a v] = E[E[a | 𝓕] v]` for `v` `𝓕`-measurable and bounded. -/
theorem integral_mul_eq_condExp_mul {𝓕 : MeasurableSpace Ω} (hF : 𝓕 ≤ m0) {a v : Ω → ℝ}
    (ham : AEStronglyMeasurable[m0] a P) (ha : Bdd1 P a) (hv : StronglyMeasurable[𝓕] v) (hvb : Bdd1 P v) :
    ∫ ω, a ω * v ω ∂P = ∫ ω, P[a|𝓕] ω * v ω ∂P := by
  have hia : Integrable a P := ha.integrable ham
  have hiav : Integrable (a * v) P := (ha.mul hvb).integrable (ham.mul (hv.mono hF).aestronglyMeasurable)
  have h := condExp_mul_of_stronglyMeasurable_right hv hiav hia
  calc ∫ ω, a ω * v ω ∂P = ∫ ω, (a * v) ω ∂P := rfl
    _ = ∫ ω, P[a * v|𝓕] ω ∂P := (integral_condExp hF).symm
    _ = ∫ ω, (P[a|𝓕] * v) ω ∂P := integral_congr_ae h
    _ = ∫ ω, P[a|𝓕] ω * v ω ∂P := rfl

/-- **The OS-norm split** (`REVIEW3-RESPONSE.md` 13.4, (A) and (B)). For bounded `a, b` and sub-σ-algebras
`𝓗_a, 𝓗_b ≤ 𝓕 ≤ m0`:
`|E[(a - E[a | 𝓗_a])(b - E[b | 𝓗_b])]| ≤ E|ccov 𝓕 a b| + 2 E|E[a | 𝓕] - E[a | 𝓗_a]|`. -/
theorem os_cross_le {𝓕 𝓗a 𝓗b : MeasurableSpace Ω} (hF : 𝓕 ≤ m0) (hHa : 𝓗a ≤ 𝓕) (hHb : 𝓗b ≤ 𝓕) {a b : Ω → ℝ}
    (ham : AEStronglyMeasurable[m0] a P) (hbm : AEStronglyMeasurable[m0] b P) (ha : Bdd1 P a) (hb : Bdd1 P b) :
    |∫ ω, (a ω - P[a|𝓗a] ω) * (b ω - P[b|𝓗b] ω) ∂P| ≤
      ∫ ω, |ccov P 𝓕 a b ω| ∂P + 2 * ∫ ω, |P[a|𝓕] ω - P[a|𝓗a] ω| ∂P := by
  -- names
  have hu : StronglyMeasurable[𝓕] (P[a|𝓗a]) := stronglyMeasurable_condExp.mono hHa
  have hv : StronglyMeasurable[𝓕] (P[b|𝓗b]) := stronglyMeasurable_condExp.mono hHb
  have bu : Bdd1 P (P[a|𝓗a]) := ha.condExp 𝓗a
  have bv : Bdd1 P (P[b|𝓗b]) := hb.condExp 𝓗b
  have bA : Bdd1 P (P[a|𝓕]) := ha.condExp 𝓕
  have bB : Bdd1 P (P[b|𝓕]) := hb.condExp 𝓕
  have mu : AEStronglyMeasurable[m0] (P[a|𝓗a]) P := integrable_condExp.1
  have mv : AEStronglyMeasurable[m0] (P[b|𝓗b]) P := integrable_condExp.1
  have mA : AEStronglyMeasurable[m0] (P[a|𝓕]) P := integrable_condExp.1
  have mB : AEStronglyMeasurable[m0] (P[b|𝓕]) P := integrable_condExp.1
  have ib : ∀ {f g : Ω → ℝ}, AEStronglyMeasurable[m0] f P → AEStronglyMeasurable[m0] g P → Bdd1 P f → Bdd1 P g →
      Integrable (fun ω => f ω * g ω) P := fun hf hg bf bg => (bf.mul bg).integrable (hf.mul hg)
  -- the four cross terms, moved under `𝓕`
  have e1 : ∫ ω, a ω * P[b|𝓗b] ω ∂P = ∫ ω, P[a|𝓕] ω * P[b|𝓗b] ω ∂P :=
    integral_mul_eq_condExp_mul hF ham ha hv bv
  have e2 : ∫ ω, P[a|𝓗a] ω * b ω ∂P = ∫ ω, P[a|𝓗a] ω * P[b|𝓕] ω ∂P := by
    rw [integral_congr_ae (ae_of_all _ fun ω => mul_comm (P[a|𝓗a] ω) (b ω)),
      integral_congr_ae (ae_of_all _ fun ω => mul_comm (P[a|𝓗a] ω) (P[b|𝓕] ω))]
    exact integral_mul_eq_condExp_mul hF hbm hb hu bu
  have e3 : ∫ ω, a ω * b ω ∂P = ∫ ω, P[a * b|𝓕] ω ∂P := (integral_condExp hF).symm
  -- expansions
  have x1 := integral_add ((ib ham hbm ha hb).sub (ib ham mv ha bv) |>.sub (ib mu hbm bu hb)) (ib mu mv bu bv)
  have x2 := integral_sub ((ib ham hbm ha hb).sub (ib ham mv ha bv)) (ib mu hbm bu hb)
  have x3 := integral_sub (ib ham hbm ha hb) (ib ham mv ha bv)
  have y1 := integral_add ((ib mA mB bA bB).sub (ib mA mv bA bv) |>.sub (ib mu mB bu bB)) (ib mu mv bu bv)
  have y2 := integral_sub ((ib mA mB bA bB).sub (ib mA mv bA bv)) (ib mu mB bu bB)
  have y3 := integral_sub (ib mA mB bA bB) (ib mA mv bA bv)
  have z1 := integral_sub (integrable_condExp (μ := P) (m := 𝓕) (f := a * b)) (ib mA mB bA bB)
  simp only [Pi.sub_apply] at x1 x2 x3 y1 y2 y3 z1
  have hlhs : ∫ ω, (a ω - P[a|𝓗a] ω) * (b ω - P[b|𝓗b] ω) ∂P =
      ∫ ω, (a ω * b ω - a ω * P[b|𝓗b] ω - P[a|𝓗a] ω * b ω + P[a|𝓗a] ω * P[b|𝓗b] ω) ∂P :=
    integral_congr_ae (ae_of_all _ fun ω => by ring)
  have hmid : ∫ ω, (P[a|𝓕] ω - P[a|𝓗a] ω) * (P[b|𝓕] ω - P[b|𝓗b] ω) ∂P =
      ∫ ω, (P[a|𝓕] ω * P[b|𝓕] ω - P[a|𝓕] ω * P[b|𝓗b] ω - P[a|𝓗a] ω * P[b|𝓕] ω +
        P[a|𝓗a] ω * P[b|𝓗b] ω) ∂P :=
    integral_congr_ae (ae_of_all _ fun ω => by ring)
  have hcc : ∫ ω, ccov P 𝓕 a b ω ∂P = ∫ ω, (P[a * b|𝓕] ω - P[a|𝓕] ω * P[b|𝓕] ω) ∂P := rfl
  -- the identity `E[(a - u)(b - v)] = E[ccov] + E[(A - u)(B - v)]`
  have hid : ∫ ω, (a ω - P[a|𝓗a] ω) * (b ω - P[b|𝓗b] ω) ∂P =
      ∫ ω, ccov P 𝓕 a b ω ∂P + ∫ ω, (P[a|𝓕] ω - P[a|𝓗a] ω) * (P[b|𝓕] ω - P[b|𝓗b] ω) ∂P := by
    rw [hlhs, hmid, hcc, x1, x2, x3, y1, y2, y3, z1, e1, e2, e3]
    ring
  -- bounds
  have hbd : ∀ᵐ ω ∂P, |(P[a|𝓕] ω - P[a|𝓗a] ω) * (P[b|𝓕] ω - P[b|𝓗b] ω)| ≤ 2 * |P[a|𝓕] ω - P[a|𝓗a] ω| := by
    filter_upwards [bB, bv] with ω h1 h2
    rw [abs_mul, mul_comm]
    refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
    calc |P[b|𝓕] ω - P[b|𝓗b] ω| ≤ |P[b|𝓕] ω| + |P[b|𝓗b] ω| := abs_sub _ _
      _ ≤ 2 := by linarith
  have iD : Integrable (fun ω => |P[a|𝓕] ω - P[a|𝓗a] ω|) P :=
    ((bA.integrable mA).sub (bu.integrable mu)).abs
  have iM : Integrable (fun ω => (P[a|𝓕] ω - P[a|𝓗a] ω) * (P[b|𝓕] ω - P[b|𝓗b] ω)) P := by
    refine Integrable.of_bound (C := 4) ((mA.sub mu).mul (mB.sub mv)) ?_
    filter_upwards [bA, bu, bB, bv] with ω h1 h2 h3 h4
    rw [Real.norm_eq_abs, abs_mul]
    have k1 := abs_sub (P[a|𝓕] ω) (P[a|𝓗a] ω)
    have k2 := abs_sub (P[b|𝓕] ω) (P[b|𝓗b] ω)
    have k3 : |P[a|𝓕] ω - P[a|𝓗a] ω| ≤ 2 := by linarith
    have k4 : |P[b|𝓕] ω - P[b|𝓗b] ω| ≤ 2 := by linarith
    nlinarith [abs_nonneg (P[a|𝓕] ω - P[a|𝓗a] ω), abs_nonneg (P[b|𝓕] ω - P[b|𝓗b] ω)]
  have hM : |∫ ω, (P[a|𝓕] ω - P[a|𝓗a] ω) * (P[b|𝓕] ω - P[b|𝓗b] ω) ∂P| ≤
      2 * ∫ ω, |P[a|𝓕] ω - P[a|𝓗a] ω| ∂P := by
    refine (abs_integral_le_integral_abs).trans ?_
    rw [← integral_const_mul]
    exact integral_mono_ae iM.abs (iD.const_mul 2) hbd
  have hC : |∫ ω, ccov P 𝓕 a b ω ∂P| ≤ ∫ ω, |ccov P 𝓕 a b ω| ∂P := abs_integral_le_integral_abs
  rw [hid]
  exact (abs_add_le _ _).trans (add_le_add hC hM)

end Prob

/-! ### The Hilbert-space half -/

section Hilbert

variable {V : Type*} [AddCommGroup V] [Module ℝ V] {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- **The OS data** (named hypothesis: the OS reconstruction of the continuum limit). The observables `V`, the
embedding `Φ` into the OS Hilbert space `H`, and the OS form `Q` (`Q u = E[θu · u]`) with `‖Φ u‖² = Q u`. -/
structure OSData (V H : Type*) [AddCommGroup V] [Module ℝ V] [NormedAddCommGroup H] [InnerProductSpace ℝ H] where
  Φ : V →ₗ[ℝ] H
  Q : V → ℝ
  norm_sq : ∀ u, ‖Φ u‖ ^ 2 = Q u

variable (O : OSData V H)

/-- **OS-norm density gives closure** (`REVIEW3-RESPONSE.md` 13.4): if for every `ε > 0` some block observable
`f ∈ Blk` has `Q(F - f) ≤ ε`, then `Φ F` lies in the closure of `Φ(Blk)`. -/
theorem mem_closure_of_os (Blk : Set V) (F : V) (hdens : ∀ ε > 0, ∃ f ∈ Blk, O.Q (F - f) ≤ ε) :
    O.Φ F ∈ closure (O.Φ '' Blk) := by
  rw [Metric.mem_closure_iff]
  intro ε hε
  obtain ⟨f, hf, hQ⟩ := hdens (ε ^ 2 / 2) (by positivity)
  refine ⟨O.Φ f, ⟨f, hf, rfl⟩, ?_⟩
  rw [dist_eq_norm, ← map_sub]
  have h2 : ‖O.Φ (F - f)‖ ^ 2 < ε ^ 2 := by rw [O.norm_sq]; linarith [sq_nonneg ε, pow_pos hε 2]
  exact abs_lt_of_sq_lt_sq' h2 hε.le |>.2 |> fun h => by simpa [abs_of_nonneg (norm_nonneg _)] using h

/-- The same from a sequence: `Q(F - f_k) → 0` with `f_k ∈ Blk` (UV-TV: `ℓ → 0` at fixed `t`). -/
theorem mem_closure_of_tendsto (Blk : Set V) (F : V) (f : ℕ → V) (hf : ∀ k, f k ∈ Blk)
    (hQ : Tendsto (fun k => O.Q (F - f k)) atTop (𝓝 0)) : O.Φ F ∈ closure (O.Φ '' Blk) := by
  refine mem_closure_of_os O Blk F fun ε hε => ?_
  obtain ⟨k, hk⟩ := (hQ.eventually (Iio_mem_nhds hε)).exists
  exact ⟨f k, hf k, hk.le⟩

/-- **The gap for observables in the block closure** (spectral upgrade, `ProofPhase.Interface.spectral_upgrade`).
`T` symmetric and positive; `H0` a closed `T`-invariant subspace containing the block vectors (named data of the
reconstruction). If every block vector decays at rate `m` with its own constant, then every observable `F` with `Φ F`
in the closure of the block vectors satisfies `⟪Φ F, T^n Φ F⟫ ≤ e^{-mn} ‖Φ F‖²`. -/
theorem gap_of_density (T : H →L[ℝ] H) (hsym : ∀ x y, ⟪T x, y⟫ = ⟪x, T y⟫) (hpos : ∀ x, 0 ≤ ⟪x, T x⟫)
    (Blk : Set V) (H0 : Submodule ℝ H) (hcl : IsClosed (H0 : Set H)) (hBlk : O.Φ '' Blk ⊆ H0)
    (hH0 : (H0 : Set H) ⊆ closure (O.Φ '' Blk)) (hinv : ∀ x ∈ H0, T x ∈ H0) (m : ℝ)
    (hdec : ∀ G ∈ O.Φ '' Blk, ∃ C : ℝ, ∀ n : ℕ, ⟪G, (T ^ n) G⟫ ≤ C * Real.exp (-(m * n)))
    (F : V) (hF : O.Φ F ∈ closure (O.Φ '' Blk)) (n : ℕ) :
    ⟪O.Φ F, (T ^ n) (O.Φ F)⟫ ≤ Real.exp (-(m * n)) * ‖O.Φ F‖ ^ 2 := by
  have hFH0 : O.Φ F ∈ H0 := (closure_minimal hBlk hcl) hF
  exact ProofPhase.Interface.spectral_upgrade hsym hpos H0 hinv (O.Φ '' Blk) hH0 m hdec (O.Φ F) hFH0 n

/-- **Lemma UV-TV gives the gap for local observables** (the two halves together). For a local observable `F` with
block approximants `f k ∈ Blk`: if `Q(F - f k) ≤ b_B k + 2 b_A k` (the OS-norm split `os_cross_le`, with `b_B` the (B)
term and `b_A` the (A) term at block scale `ℓ_k`) and both tend to `0`, then `F` has the block rate:
`⟪Φ F, T^n Φ F⟫ ≤ e^{-mn} ‖Φ F‖²`. -/
theorem gap_of_UVTV (T : H →L[ℝ] H) (hsym : ∀ x y, ⟪T x, y⟫ = ⟪x, T y⟫) (hpos : ∀ x, 0 ≤ ⟪x, T x⟫)
    (Blk : Set V) (H0 : Submodule ℝ H) (hcl : IsClosed (H0 : Set H)) (hBlk : O.Φ '' Blk ⊆ H0)
    (hH0 : (H0 : Set H) ⊆ closure (O.Φ '' Blk)) (hinv : ∀ x ∈ H0, T x ∈ H0) (m : ℝ)
    (hdec : ∀ G ∈ O.Φ '' Blk, ∃ C : ℝ, ∀ n : ℕ, ⟪G, (T ^ n) G⟫ ≤ C * Real.exp (-(m * n)))
    (F : V) (f : ℕ → V) (hf : ∀ k, f k ∈ Blk) (bA bB : ℕ → ℝ)
    (hsplit : ∀ k, O.Q (F - f k) ≤ bB k + 2 * bA k)
    (hA : Tendsto bA atTop (𝓝 0)) (hB : Tendsto bB atTop (𝓝 0)) (n : ℕ) :
    ⟪O.Φ F, (T ^ n) (O.Φ F)⟫ ≤ Real.exp (-(m * n)) * ‖O.Φ F‖ ^ 2 := by
  have hQ0 : ∀ k, 0 ≤ O.Q (F - f k) := fun k => by rw [← O.norm_sq]; positivity
  have hlim : Tendsto (fun k => bB k + 2 * bA k) atTop (𝓝 0) := by
    simpa using hB.add (hA.const_mul 2)
  have hQ : Tendsto (fun k => O.Q (F - f k)) atTop (𝓝 0) :=
    tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hlim hQ0 hsplit
  exact gap_of_density O T hsym hpos Blk H0 hcl hBlk hH0 hinv m hdec F
    (mem_closure_of_tendsto O Blk F f hf hQ) n

end Hilbert

end ProofPhase.M1.UVTV
