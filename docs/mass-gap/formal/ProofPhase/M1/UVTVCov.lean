/-
Proof phase, M1 tools (m1-tools), Lean phase, module 3: statement (B) of Lemma UV-TV by the law of total covariance
along the scale filtration (2026-11-23). Released under Apache 2.0.

Paper: `docs/mass-gap/weak-coupling/proof-phase/m1-tools/UV-TV.md`, section 38.1.
-/

import ProofPhase.M1.UVTVFront

/-!
# (B) by the law of total covariance along the scales

A probability space `(Ω, P)` (the bare field with the noise of the blocking chain) and a **decreasing** sequence of
sub-σ-algebras `G 0 ≥ G 1 ≥ … ≥ G n` (`G j = σ(X_j, …, X_ℓ)`, generated by the system's own block states; `G n` is the
block state `𝓕_ℓ` at the top scale). For bounded `f`, `g` (`|f|, |g| ≤ 1`), with `M j = E[f | G j]`, `N j = E[g | G j]`:

* `ccov m a b = E[ab | m] - E[a | m] E[b | m]`, the conditional covariance.
* `total_cov_ae`: **the identity** (exact, a.e.):
  `ccov (G n) f g = E[ccov (G 0) f g | G n] + Σ_{j<n} E[ccov (G (j+1)) (M j) (N j) | G n]`.
  It uses only the tower property and the pull-out of `G n`-measurable functions.
* `total_cov_integral_le`: in `L¹`,
  `E|ccov (G n) f g| ≤ E|ccov (G 0) f g| + Σ_{j<n} E|ccov (G (j+1)) (M j) (N j)|`.
* `ccov_integral_le_local`: **localisation of one term**: for bounded `a, b, φ, ψ`,
  `E|ccov m a b| ≤ E|ccov m φ ψ| + 2 E|a - φ| + 2 E|b - ψ|`.
* `statementB`: **(B), assembled.** With the named inputs
  * `(A)` at each scale: `E|M j - φ j| ≤ δ j`, `E|N j - ψ j| ≤ δ' j`, with `φ j`, `ψ j` the local versions (functions of
    the scale-`j` state near `A` and near `θA`; module 2 at top scale `j`);
  * one-kernel decorrelation: `E|ccov (G (j+1)) (φ j) (ψ j)| ≤ η j` (33.3's argument at scale `j`);
  * the bare term: `E|ccov (G 0) f g| ≤ η₀` (the truncated last kernel, 38.4);

  it gives `E|ccov (G n) f g| ≤ η₀ + Σ_{j<n} (η j + 2 δ j + 2 δ' j)`.
* `statementB_geom`: with every per-scale input `≤ c ρ^(n-1-j) x^{-r}` (geometric from the top), the bound is
  `η₀ + 5 c x^{-r}/(1 - ρ)`.

Nothing is conditioned on bare content across scales: the only conditionings are on the filtration `G j`. That the
`j`-th term is a covariance under the single kernel `K_j(· | X_{j+1})` (the Markov property of the blocking chain) is
the paper's identification of the inputs `η j`, not needed here.
-/

open MeasureTheory Finset

open scoped ENNReal NNReal

set_option linter.unusedSectionVars false

noncomputable section

namespace ProofPhase.M1.UVTV

variable {Ω : Type*} {m0 : MeasurableSpace Ω} {P : Measure Ω} [IsProbabilityMeasure P]

/-- The conditional covariance `E[ab | m] - E[a | m] E[b | m]`. -/
def ccov (P : Measure Ω) (m : MeasurableSpace Ω) (a b : Ω → ℝ) : Ω → ℝ :=
  P[a * b|m] - P[a|m] * P[b|m]

/-- `|f| ≤ 1` almost everywhere. -/
def Bdd1 (P : Measure Ω) (f : Ω → ℝ) : Prop := ∀ᵐ ω ∂P, |f ω| ≤ 1

/-! ### Bounded functions -/

theorem Bdd1.condExp {f : Ω → ℝ} (hf : Bdd1 P f) (m : MeasurableSpace Ω) : Bdd1 P (P[f|m]) := by
  exact ae_bdd_abs_condExp_of_ae_bdd_abs (m := m) (μ := P) (R := (1 : ℝ)) (f := f) hf

theorem Bdd1.mul {f g : Ω → ℝ} (hf : Bdd1 P f) (hg : Bdd1 P g) : Bdd1 P (f * g) := by
  filter_upwards [hf, hg] with ω h1 h2
  rw [Pi.mul_apply, abs_mul]
  nlinarith [abs_nonneg (f ω), abs_nonneg (g ω)]

theorem Bdd1.integrable {f : Ω → ℝ} (hm : AEStronglyMeasurable f P) (hf : Bdd1 P f) : Integrable f P :=
  Integrable.of_bound (C := 1) hm (by filter_upwards [hf] with ω h; rwa [Real.norm_eq_abs])

theorem integrable_condExp_mul_condExp {f g : Ω → ℝ} (hf : Bdd1 P f) (hg : Bdd1 P g) (m₁ m₂ : MeasurableSpace Ω) :
    Integrable (P[f|m₁] * P[g|m₂]) P :=
  Bdd1.integrable (integrable_condExp.1.mul integrable_condExp.1) ((hf.condExp m₁).mul (hg.condExp m₂))

/-! ### The identity -/

section Filtration

variable (G : ℕ → MeasurableSpace Ω) (hG : ∀ j, G j ≤ m0) (hanti : ∀ j, G (j + 1) ≤ G j)
  {f g : Ω → ℝ} (hfm : AEStronglyMeasurable f P) (hgm : AEStronglyMeasurable g P) (hf : Bdd1 P f) (hg : Bdd1 P g)

include hanti in
theorem filtration_le {i j : ℕ} (hij : i ≤ j) : G j ≤ G i :=
  (antitone_nat_of_succ_le hanti) hij

include hG hanti hf hg in
/-- One step of the telescoping: `E[ccov (G (j+1)) (M j) (N j) | G n] = E[M j N j | G n] - E[M (j+1) N (j+1) | G n]`
for `j + 1 ≤ n`. -/
theorem condExp_ccov_step {j n : ℕ} (hjn : j + 1 ≤ n) :
    P[ccov P (G (j + 1)) (P[f|G j]) (P[g|G j])|G n] =ᵐ[P]
      P[P[f|G j] * P[g|G j]|G n] - P[P[f|G (j + 1)] * P[g|G (j + 1)]|G n] := by
  have hMM : P[P[f|G j]|G (j + 1)] =ᵐ[P] P[f|G (j + 1)] := condExp_condExp_of_le (hanti j) (hG j)
  have hNN : P[P[g|G j]|G (j + 1)] =ᵐ[P] P[g|G (j + 1)] := condExp_condExp_of_le (hanti j) (hG j)
  have hc : ccov P (G (j + 1)) (P[f|G j]) (P[g|G j]) =ᵐ[P]
      P[P[f|G j] * P[g|G j]|G (j + 1)] - P[f|G (j + 1)] * P[g|G (j + 1)] := by
    filter_upwards [hMM, hNN] with ω h1 h2
    simp only [ccov, Pi.sub_apply, Pi.mul_apply, h1, h2]
  have h1 := condExp_congr_ae (m := G n) hc
  have h2 := condExp_sub (m := G n) (integrable_condExp (μ := P) (m := G (j + 1)) (f := P[f|G j] * P[g|G j]))
    (integrable_condExp_mul_condExp hf hg (G (j + 1)) (G (j + 1)))
  have h3 : P[P[P[f|G j] * P[g|G j]|G (j + 1)]|G n] =ᵐ[P] P[P[f|G j] * P[g|G j]|G n] :=
    condExp_condExp_of_le (filtration_le G hanti hjn) (hG (j + 1))
  filter_upwards [h1, h2, h3] with ω e1 e2 e3
  rw [e1, e2, Pi.sub_apply, Pi.sub_apply, e3]

include hG hanti hf hg in
/-- The telescoped sum: `Σ_{j<n} E[ccov (G (j+1)) (M j) (N j) | G n] = E[M 0 N 0 | G n] - E[M n N n | G n]`. -/
theorem sum_condExp_ccov (n : ℕ) :
    (∑ j ∈ range n, P[ccov P (G (j + 1)) (P[f|G j]) (P[g|G j])|G n]) =ᵐ[P]
      P[P[f|G 0] * P[g|G 0]|G n] - P[P[f|G n] * P[g|G n]|G n] := by
  have hall : ∀ᵐ ω ∂P, ∀ j : ℕ, j + 1 ≤ n →
      P[ccov P (G (j + 1)) (P[f|G j]) (P[g|G j])|G n] ω =
        P[P[f|G j] * P[g|G j]|G n] ω - P[P[f|G (j + 1)] * P[g|G (j + 1)]|G n] ω := by
    rw [ae_all_iff]
    intro j
    by_cases hj : j + 1 ≤ n
    · filter_upwards [condExp_ccov_step G hG hanti hf hg hj] with ω h _
      simpa only [Pi.sub_apply] using h
    · exact ae_of_all _ fun ω h => absurd h hj
  filter_upwards [hall] with ω h
  rw [Finset.sum_apply, Pi.sub_apply]
  rw [Finset.sum_congr rfl fun j hj => h j (Finset.mem_range.mp hj)]
  exact Finset.sum_range_sub' (fun j => P[P[f|G j] * P[g|G j]|G n] ω) n

include hG hf hg in
/-- The top term is `G n`-measurable: `E[M n N n | G n] = M n N n`. -/
theorem condExp_top (n : ℕ) : P[P[f|G n] * P[g|G n]|G n] = P[f|G n] * P[g|G n] :=
  condExp_of_stronglyMeasurable (hG n) (stronglyMeasurable_condExp.mul stronglyMeasurable_condExp)
    (integrable_condExp_mul_condExp hf hg (G n) (G n))

include hG hanti hfm hgm hf hg in
/-- The base term: `E[ccov (G 0) f g | G n] = E[fg | G n] - E[M 0 N 0 | G n]`. -/
theorem condExp_ccov_base (n : ℕ) :
    P[ccov P (G 0) f g|G n] =ᵐ[P] P[f * g|G n] - P[P[f|G 0] * P[g|G 0]|G n] := by
  have hfg : Integrable (f * g) P := Bdd1.integrable (hfm.mul hgm) (hf.mul hg)
  have h2 := condExp_sub (m := G n) (integrable_condExp (μ := P) (m := G 0) (f := f * g))
    (integrable_condExp_mul_condExp hf hg (G 0) (G 0))
  have h3 : P[P[f * g|G 0]|G n] =ᵐ[P] P[f * g|G n] :=
    condExp_condExp_of_le (filtration_le G hanti (Nat.zero_le n)) (hG 0)
  filter_upwards [h2, h3] with ω e2 e3
  simp only [ccov] at e2 ⊢
  rw [e2, Pi.sub_apply, Pi.sub_apply, e3]

include hG hanti hfm hgm hf hg in
/-- **The law of total covariance along the filtration** (`UV-TV.md` 38.1, exact):
`ccov (G n) f g = E[ccov (G 0) f g | G n] + Σ_{j<n} E[ccov (G (j+1)) (M j) (N j) | G n]` almost everywhere. -/
theorem total_cov_ae (n : ℕ) :
    ccov P (G n) f g =ᵐ[P]
      P[ccov P (G 0) f g|G n] + ∑ j ∈ range n, P[ccov P (G (j + 1)) (P[f|G j]) (P[g|G j])|G n] := by
  have hs := sum_condExp_ccov G hG hanti hf hg n
  have hb := condExp_ccov_base G hG hanti hfm hgm hf hg n
  have ht := condExp_top G hG hf hg n
  filter_upwards [hs, hb] with ω e1 e2
  rw [Pi.add_apply, e1, e2, ht]
  simp only [ccov, Pi.sub_apply, Pi.mul_apply]
  ring

include hG hanti hfm hgm hf hg in
/-- **In `L¹`**: `E|ccov (G n) f g| ≤ E|ccov (G 0) f g| + Σ_{j<n} E|ccov (G (j+1)) (M j) (N j)|`. -/
theorem total_cov_integral_le (n : ℕ) :
    ∫ ω, |ccov P (G n) f g ω| ∂P ≤
      ∫ ω, |ccov P (G 0) f g ω| ∂P + ∑ j ∈ range n, ∫ ω, |ccov P (G (j + 1)) (P[f|G j]) (P[g|G j]) ω| ∂P := by
  have hid := total_cov_ae G hG hanti hfm hgm hf hg n
  set c0 := ccov P (G 0) f g with hc0
  set c : ℕ → Ω → ℝ := fun j => ccov P (G (j + 1)) (P[f|G j]) (P[g|G j]) with hc
  have hi0 : Integrable (fun ω => |P[c0|G n] ω|) P := integrable_condExp.abs
  have hic : ∀ j, Integrable (fun ω => |P[c j|G n] ω|) P := fun j => integrable_condExp.abs
  have hisum : Integrable (fun ω => |P[c0|G n] ω| + ∑ j ∈ range n, |P[c j|G n] ω|) P :=
    hi0.add (integrable_finsetSum _ fun j _ => hic j)
  calc ∫ ω, |ccov P (G n) f g ω| ∂P
      = ∫ ω, |(P[c0|G n] + ∑ j ∈ range n, P[c j|G n]) ω| ∂P :=
        integral_congr_ae (hid.mono fun ω h => by dsimp only; rw [h])
    _ ≤ ∫ ω, (|P[c0|G n] ω| + ∑ j ∈ range n, |P[c j|G n] ω|) ∂P := by
        refine integral_mono_of_nonneg (ae_of_all _ fun ω => abs_nonneg _) hisum (ae_of_all _ fun ω => ?_)
        dsimp only
        rw [Pi.add_apply, Finset.sum_apply]
        exact (abs_add_le _ _).trans (add_le_add le_rfl (Finset.abs_sum_le_sum_abs _ _))
    _ = ∫ ω, |P[c0|G n] ω| ∂P + ∑ j ∈ range n, ∫ ω, |P[c j|G n] ω| ∂P := by
        rw [integral_add hi0 (integrable_finsetSum _ fun j _ => hic j), integral_finsetSum _ fun j _ => hic j]
    _ ≤ ∫ ω, |c0 ω| ∂P + ∑ j ∈ range n, ∫ ω, |c j ω| ∂P :=
        add_le_add (integral_abs_condExp_le c0) (Finset.sum_le_sum fun j _ => integral_abs_condExp_le (c j))

end Filtration

/-! ### Localisation of one term -/

theorem integrable_ccov (m : MeasurableSpace Ω) {a b : Ω → ℝ} (ha : Bdd1 P a) (hb : Bdd1 P b) :
    Integrable (ccov P m a b) P :=
  integrable_condExp.sub (integrable_condExp_mul_condExp ha hb m m)

/-- **Localisation of one term** (`UV-TV.md` 38.1, step 1): for `|a|, |b|, |φ|, |ψ| ≤ 1`,
`E|ccov m a b| ≤ E|ccov m φ ψ| + 2 E|a - φ| + 2 E|b - ψ|`. (The sub-σ-algebra `m` comes last, so that it is not
picked up as the ambient measurable space in the measurability hypotheses.) -/
theorem ccov_integral_le_local {a b φ ψ : Ω → ℝ}
    (ham : AEStronglyMeasurable a P) (hbm : AEStronglyMeasurable b P)
    (hφm : AEStronglyMeasurable φ P) (hψm : AEStronglyMeasurable ψ P)
    (ha : Bdd1 P a) (hb : Bdd1 P b) (hφ : Bdd1 P φ) (hψ : Bdd1 P ψ) (m : MeasurableSpace Ω) :
    ∫ ω, |ccov P m a b ω| ∂P ≤
      ∫ ω, |ccov P m φ ψ ω| ∂P + 2 * ∫ ω, |(a - φ) ω| ∂P + 2 * ∫ ω, |(b - ψ) ω| ∂P := by
  have hia : Integrable a P := ha.integrable ham
  have hib : Integrable b P := hb.integrable hbm
  have hiφ : Integrable φ P := hφ.integrable hφm
  have hiψ : Integrable ψ P := hψ.integrable hψm
  have hiab : Integrable (a * b) P := (ha.mul hb).integrable (ham.mul hbm)
  have hiφψ : Integrable (φ * ψ) P := (hφ.mul hψ).integrable (hφm.mul hψm)
  have e1 := condExp_sub (m := m) hiab hiφψ
  have e2 := condExp_sub (m := m) hia hiφ
  have e3 := condExp_sub (m := m) hib hiψ
  have bb := hb.condExp m
  have bφ := hφ.condExp m
  -- the pointwise bound
  have hpt : ∀ᵐ ω ∂P, |ccov P m a b ω| ≤
      |ccov P m φ ψ ω| + (|P[a * b - φ * ψ|m] ω| + |P[a - φ|m] ω| + |P[b - ψ|m] ω|) := by
    filter_upwards [e1, e2, e3, bb, bφ] with ω h1 h2 h3 h4 h5
    simp only [ccov, Pi.sub_apply, Pi.mul_apply] at h1 h2 h3 ⊢
    rw [h1, h2, h3]
    have key : P[a * b|m] ω - P[a|m] ω * P[b|m] ω =
        (P[φ * ψ|m] ω - P[φ|m] ω * P[ψ|m] ω) + ((P[a * b|m] ω - P[φ * ψ|m] ω) -
          ((P[a|m] ω - P[φ|m] ω) * P[b|m] ω + P[φ|m] ω * (P[b|m] ω - P[ψ|m] ω))) := by ring
    rw [key]
    have k1 : |(P[a|m] ω - P[φ|m] ω) * P[b|m] ω| ≤ |P[a|m] ω - P[φ|m] ω| := by
      rw [abs_mul]; exact mul_le_of_le_one_right (abs_nonneg _) h4
    have k2 : |P[φ|m] ω * (P[b|m] ω - P[ψ|m] ω)| ≤ |P[b|m] ω - P[ψ|m] ω| := by
      rw [abs_mul]; exact mul_le_of_le_one_left (abs_nonneg _) h5
    have k3 := abs_add_le ((P[a|m] ω - P[φ|m] ω) * P[b|m] ω) (P[φ|m] ω * (P[b|m] ω - P[ψ|m] ω))
    have k4 := abs_sub (P[a * b|m] ω - P[φ * ψ|m] ω)
      ((P[a|m] ω - P[φ|m] ω) * P[b|m] ω + P[φ|m] ω * (P[b|m] ω - P[ψ|m] ω))
    have k5 := abs_add_le (P[φ * ψ|m] ω - P[φ|m] ω * P[ψ|m] ω) ((P[a * b|m] ω - P[φ * ψ|m] ω) -
          ((P[a|m] ω - P[φ|m] ω) * P[b|m] ω + P[φ|m] ω * (P[b|m] ω - P[ψ|m] ω)))
    linarith
  -- the product difference
  have hab : ∀ᵐ ω ∂P, |(a * b - φ * ψ) ω| ≤ |(a - φ) ω| + |(b - ψ) ω| := by
    filter_upwards [hb, hφ] with ω h1 h2
    simp only [Pi.sub_apply, Pi.mul_apply]
    have key : a ω * b ω - φ ω * ψ ω = (a ω - φ ω) * b ω + φ ω * (b ω - ψ ω) := by ring
    rw [key]
    have k1 : |(a ω - φ ω) * b ω| ≤ |a ω - φ ω| := by
      rw [abs_mul]; exact mul_le_of_le_one_right (abs_nonneg _) h1
    have k2 : |φ ω * (b ω - ψ ω)| ≤ |b ω - ψ ω| := by
      rw [abs_mul]; exact mul_le_of_le_one_left (abs_nonneg _) h2
    linarith [abs_add_le ((a ω - φ ω) * b ω) (φ ω * (b ω - ψ ω))]
  have iC1 : Integrable (fun ω => |ccov P m φ ψ ω|) P := (integrable_ccov m hφ hψ).abs
  have iE1 : Integrable (fun ω => |P[a * b - φ * ψ|m] ω|) P := integrable_condExp.abs
  have iE2 : Integrable (fun ω => |P[a - φ|m] ω|) P := integrable_condExp.abs
  have iE3 : Integrable (fun ω => |P[b - ψ|m] ω|) P := integrable_condExp.abs
  have iD1 : Integrable (fun ω => |(a - φ) ω|) P := (hia.sub hiφ).abs
  have iD2 : Integrable (fun ω => |(b - ψ) ω|) P := (hib.sub hiψ).abs
  have iD0 : Integrable (fun ω => |(a * b - φ * ψ) ω|) P := (hiab.sub hiφψ).abs
  have s1 : ∫ ω, |ccov P m a b ω| ∂P ≤
      ∫ ω, (|ccov P m φ ψ ω| + (|P[a * b - φ * ψ|m] ω| + |P[a - φ|m] ω| + |P[b - ψ|m] ω|)) ∂P :=
    integral_mono_ae (integrable_ccov m ha hb).abs (iC1.add ((iE1.add iE2).add iE3)) hpt
  have t1 := integral_add iC1 ((iE1.add iE2).add iE3)
  have t2 := integral_add (iE1.add iE2) iE3
  have t3 := integral_add iE1 iE2
  simp only [Pi.add_apply] at t1 t2 t3
  have s2 : ∫ ω, |P[a * b - φ * ψ|m] ω| ∂P ≤ ∫ ω, |(a - φ) ω| ∂P + ∫ ω, |(b - ψ) ω| ∂P := by
    rw [← integral_add iD1 iD2]
    exact (integral_abs_condExp_le _).trans (integral_mono_ae iD0 (iD1.add iD2) hab)
  have s3 : ∫ ω, |P[a - φ|m] ω| ∂P ≤ ∫ ω, |(a - φ) ω| ∂P := integral_abs_condExp_le _
  have s4 : ∫ ω, |P[b - ψ|m] ω| ∂P ≤ ∫ ω, |(b - ψ) ω| ∂P := integral_abs_condExp_le _
  linarith

/-! ### (B), assembled -/

/-- **Statement (B) of Lemma UV-TV** (`UV-TV.md` 38.1), with the per-scale inputs as named hypotheses:
* `hA`, `hA'` ((A) at top scale `j`): `E|M j - φ j| ≤ δ j`, `E|N j - ψ j| ≤ δ' j`, for local versions `φ j`, `ψ j`
  (bounded by 1);
* `hdec` (one-kernel decorrelation, 33.3 at scale `j`): `E|ccov (G (j+1)) (φ j) (ψ j)| ≤ η j`;
* `hbase` (the last kernel, 38.4): `E|ccov (G 0) f g| ≤ η₀`.

Then `E|ccov (G n) f g| ≤ η₀ + Σ_{j<n} (η j + 2 δ j + 2 δ' j)`. -/
theorem statementB (G : ℕ → MeasurableSpace Ω) (hG : ∀ j, G j ≤ m0) (hanti : ∀ j, G (j + 1) ≤ G j)
    {f g : Ω → ℝ} (hfm : AEStronglyMeasurable f P) (hgm : AEStronglyMeasurable g P) (hf : Bdd1 P f)
    (hg : Bdd1 P g) (n : ℕ) (φ ψ : ℕ → Ω → ℝ) (hφm : ∀ j, AEStronglyMeasurable (φ j) P)
    (hψm : ∀ j, AEStronglyMeasurable (ψ j) P) (hφ : ∀ j, Bdd1 P (φ j)) (hψ : ∀ j, Bdd1 P (ψ j))
    (δ δ' η : ℕ → ℝ) (η₀ : ℝ)
    (hA : ∀ j < n, ∫ ω, |(P[f|G j] - φ j) ω| ∂P ≤ δ j)
    (hA' : ∀ j < n, ∫ ω, |(P[g|G j] - ψ j) ω| ∂P ≤ δ' j)
    (hdec : ∀ j < n, ∫ ω, |ccov P (G (j + 1)) (φ j) (ψ j) ω| ∂P ≤ η j)
    (hbase : ∫ ω, |ccov P (G 0) f g ω| ∂P ≤ η₀) :
    ∫ ω, |ccov P (G n) f g ω| ∂P ≤ η₀ + ∑ j ∈ range n, (η j + 2 * δ j + 2 * δ' j) := by
  refine (total_cov_integral_le G hG hanti hfm hgm hf hg n).trans (add_le_add hbase (Finset.sum_le_sum ?_))
  intro j hj
  have hjn := Finset.mem_range.mp hj
  have hloc := ccov_integral_le_local (P := P) (integrable_condExp (m := G j) (f := f)).1
    (integrable_condExp (m := G j) (f := g)).1 (hφm j) (hψm j) (hf.condExp (G j)) (hg.condExp (G j)) (hφ j) (hψ j)
    (G (j + 1))
  linarith [hA j hjn, hA' j hjn, hdec j hjn]

/-- **(B) with geometric inputs** (`UV-TV.md` 38.1, the sum): if every per-scale input is at most
`c ρ^(n-1-j) x^{-r}` (geometric from the top scale, `ρ = L^{-d C_2}`, `x = t/ℓ`), then
`E|ccov (G n) f g| ≤ η₀ + 5 c x^{-r}/(1 - ρ)`. -/
theorem statementB_geom (G : ℕ → MeasurableSpace Ω) (hG : ∀ j, G j ≤ m0) (hanti : ∀ j, G (j + 1) ≤ G j)
    {f g : Ω → ℝ} (hfm : AEStronglyMeasurable f P) (hgm : AEStronglyMeasurable g P) (hf : Bdd1 P f)
    (hg : Bdd1 P g) (n : ℕ) (φ ψ : ℕ → Ω → ℝ) (hφm : ∀ j, AEStronglyMeasurable (φ j) P)
    (hψm : ∀ j, AEStronglyMeasurable (ψ j) P) (hφ : ∀ j, Bdd1 P (φ j)) (hψ : ∀ j, Bdd1 P (ψ j))
    {ρ c x r η₀ : ℝ} (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) (hc : 0 ≤ c) (hx : 0 < x)
    (hA : ∀ j < n, ∫ ω, |(P[f|G j] - φ j) ω| ∂P ≤ c * ρ ^ (n - 1 - j) * x ^ (-r))
    (hA' : ∀ j < n, ∫ ω, |(P[g|G j] - ψ j) ω| ∂P ≤ c * ρ ^ (n - 1 - j) * x ^ (-r))
    (hdec : ∀ j < n, ∫ ω, |ccov P (G (j + 1)) (φ j) (ψ j) ω| ∂P ≤ c * ρ ^ (n - 1 - j) * x ^ (-r))
    (hbase : ∫ ω, |ccov P (G 0) f g ω| ∂P ≤ η₀) :
    ∫ ω, |ccov P (G n) f g ω| ∂P ≤ η₀ + 5 * (c * x ^ (-r) / (1 - ρ)) := by
  have h := statementB G hG hanti hfm hgm hf hg n φ ψ hφm hψm hφ hψ (fun j => c * ρ ^ (n - 1 - j) * x ^ (-r))
    (fun j => c * ρ ^ (n - 1 - j) * x ^ (-r)) (fun j => c * ρ ^ (n - 1 - j) * x ^ (-r)) η₀ hA hA' hdec hbase
  have hsum : ∑ j ∈ range n, (c * ρ ^ (n - 1 - j) * x ^ (-r) + 2 * (c * ρ ^ (n - 1 - j) * x ^ (-r)) +
      2 * (c * ρ ^ (n - 1 - j) * x ^ (-r))) = 5 * ∑ k ∈ range n, c * ρ ^ k * x ^ (-r) := by
    rw [Finset.mul_sum, ← Finset.sum_range_reflect (fun k => 5 * (c * ρ ^ k * x ^ (-r))) n]
    exact Finset.sum_congr rfl fun j _ => by ring
  rw [hsum] at h
  linarith [sum_geom_le (r := r) hρ0 hρ1 hc hx n]

end ProofPhase.M1.UVTV
