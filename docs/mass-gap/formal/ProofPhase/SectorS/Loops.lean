import AreaLaw.WilsonLoop
import AreaLaw.Concrete

/-!
# Every product of SU(2) Wilson loops is a sum of single Wilson loops (the algebra half of Giles on the lattice)

Giles (Phys. Rev. D 24 (1981) 2160) reconstructs a gauge field from its Wilson loops; on a finite lattice the statement the
owner's reading needs is: **the gauge-invariant observables are generated by Wilson loops** ("every neutral excitation is
built from closed flux"). It has two halves:

1. **algebra** (this file, Lean): for SU(2) the *linear span* of single Wilson loops based at one site is already closed
   under multiplication and contains the constants, so it is a subalgebra (`loopAlgebra`), and all its elements are gauge
   invariant. The engine is the **SU(2) Mandelstam identity** `tr A · tr B = tr(AB) + tr(AB⁻¹)` (`su2_mandelstam`), from
   Cayley–Hamilton `B + B⁻¹ = (tr B)·1` for `det B = 1`. On loops: `W_p W_q = W_{p q} + W_{p q̄}` (`wilsonLoop_mul`),
   `q̄` the reversed loop (`pathRev`). Loops based elsewhere enter through lassos `c q c̄` (`wilsonLoop_lasso`).
2. **separation and density** (paper, `NOTE.md` 3.2; not formalised): two configurations with equal traces on all loops
   are gauge equivalent (characters determine semisimple representations of the free group of loops, and unitarily
   equivalent SU(2) tuples are SU(2)-conjugate), so by Stone–Weierstrass this algebra is uniformly dense in the continuous
   gauge-invariant functions of the links (on a connected lattice region, loops at one base point).

**Claim discipline.** Lean, substantive but elementary (2×2 matrix algebra and path bookkeeping). The Mandelstam
identity is **SU(2)-specific** (it holds for `SL(2)`; for SU(N), N ≥ 3, a product of two traces is not a sum of traces
and the span of single loops is not an algebra: one needs multi-loops). Nothing here concerns the measure, the action,
the coupling or the dynamics: it holds for the SU(2) × U(1) product theory's SU(2) factor and for every finite subgroup
of SU(2) (which inherit the identity). It is a statement about what the neutral sector is **built from**, not about what
it **costs**; the note (section 4) shows the cost side is where Conjecture S breaks.
-/

open AreaLaw.Concrete

noncomputable section

namespace ProofPhase.SectorS

/-! ## SU(2) matrix facts -/

local notation "M2" => Matrix (Fin 2) (Fin 2) ℂ

theorem su2_rep (A : SU2) : HasGaugeTrace.rep (G := SU2) (n := 2) A = (A : M2) := rfl

theorem su2_coe_inv (A : SU2) : ((A⁻¹ : SU2) : M2) = star (A : M2) := rfl

/-- For `A ∈ SU(2)`: `A* = adj A` (unitary and determinant one). -/
theorem su2_star_eq_adjugate (A : SU2) : star (A : M2) = Matrix.adjugate (A : M2) := by
  have hu : star (A : M2) * (A : M2) = 1 :=
    Matrix.mem_unitaryGroup_iff'.1 (Matrix.specialUnitaryGroup_le_unitaryGroup A.2)
  have hd : (A : M2).det = 1 := (Matrix.mem_specialUnitaryGroup_iff.1 A.2).2
  have ha : (A : M2) * Matrix.adjugate (A : M2) = 1 := by rw [Matrix.mul_adjugate, hd, one_smul]
  calc star (A : M2) = star (A : M2) * ((A : M2) * Matrix.adjugate (A : M2)) := by rw [ha, mul_one]
    _ = (star (A : M2) * (A : M2)) * Matrix.adjugate (A : M2) := by rw [mul_assoc]
    _ = Matrix.adjugate (A : M2) := by rw [hu, one_mul]

/-- **Cayley–Hamilton for 2×2:** `B + adj B = (tr B)·1`. -/
theorem fin_two_add_adjugate (B : M2) : B + Matrix.adjugate B = Matrix.trace B • (1 : M2) := by
  rw [Matrix.adjugate_fin_two, Matrix.trace_fin_two]
  ext i j
  fin_cases i <;> fin_cases j <;> simp <;> ring

/-- The trace of an SU(2) matrix is real. -/
theorem su2_trace_im (A : SU2) : (Matrix.trace (A : M2)).im = 0 := by
  have h := congrFun (congrFun (su2_star_eq_adjugate A) 0) 0
  rw [Matrix.star_apply, Matrix.adjugate_fin_two] at h
  simp only [Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero, Matrix.empty_val',
    Matrix.cons_val_fin_one] at h
  rw [Matrix.trace_fin_two, ← h]
  simp [Complex.add_im]

/-- **SU(2) Mandelstam identity (complex form):** `tr A · tr B = tr(AB) + tr(AB*)`. -/
theorem su2_trace_mandelstam (A B : SU2) :
    Matrix.trace (A : M2) * Matrix.trace (B : M2) =
      Matrix.trace ((A : M2) * (B : M2)) + Matrix.trace ((A : M2) * star (B : M2)) := by
  rw [su2_star_eq_adjugate B, ← Matrix.trace_add, ← mul_add, fin_two_add_adjugate, Matrix.mul_smul, mul_one,
    Matrix.trace_smul, smul_eq_mul, mul_comm]

/-- **SU(2) Mandelstam identity:** `Re tr A · Re tr B = Re tr(AB) + Re tr(AB⁻¹)`. -/
theorem su2_mandelstam (A B : SU2) :
    gaugeReTr SU2 2 A * gaugeReTr SU2 2 B = gaugeReTr SU2 2 (A * B) + gaugeReTr SU2 2 (A * B⁻¹) := by
  simp only [gaugeReTr, gaugeTrace, map_mul, su2_rep, su2_coe_inv]
  rw [← Complex.add_re, ← su2_trace_mandelstam, Complex.mul_re, su2_trace_im A, su2_trace_im B]
  ring

/-- `Re tr 1 = 2`. -/
theorem su2_reTr_one : gaugeReTr SU2 2 (1 : SU2) = 2 := by
  simp [gaugeReTr, gaugeTrace]

/-! ## Reversed paths -/

variable {d N : ℕ}

/-- A step traversed the other way. -/
def _root_.PathStep.flip (s : PathStep d N) : PathStep d N := ⟨s.link, !s.fwd⟩

/-- The reversed path. -/
def pathRev (p : List (PathStep d N)) : List (PathStep d N) := (p.map PathStep.flip).reverse

theorem pathRev_cons (s : PathStep d N) (p : List (PathStep d N)) : pathRev (s :: p) = pathRev p ++ [s.flip] := by
  simp [pathRev]

theorem _root_.PathStep.flip_hol {G : Type*} [Group G] (U : GaugeConnection G d N) (s : PathStep d N) :
    s.flip.hol U = (s.hol U)⁻¹ := by
  cases h : s.fwd <;> simp [PathStep.flip, PathStep.hol, h]

theorem pathHol_rev {G : Type*} [Group G] (U : GaugeConnection G d N) (p : List (PathStep d N)) :
    pathHol U (pathRev p) = (pathHol U p)⁻¹ := by
  induction p with
  | nil => simp [pathRev, pathHol]
  | cons s p ih =>
    rw [pathRev_cons, pathHol_append, ih, pathHol, pathHol, pathHol, PathStep.flip_hol, mul_one, mul_inv_rev]

theorem pathChain_rev : ∀ {x y : FinLatticeSites d N} (p : List (PathStep d N)), PathChain x p y →
    PathChain y (pathRev p) x
  | x, y, [], h => by simp only [PathChain] at h; subst h; simp [pathRev, PathChain]
  | x, y, s :: p, h => by
    obtain ⟨hs, hp⟩ := h
    rw [pathRev_cons]
    refine pathChain_append (pathChain_rev p hp) ?_
    cases hf : s.fwd <;>
      simp_all [PathChain, PathStep.flip, PathStep.src, PathStep.tgt]

theorem isLoop_append {x : FinLatticeSites d N} {p q : List (PathStep d N)} (hp : IsLoop x p) (hq : IsLoop x q) :
    IsLoop x (p ++ q) := pathChain_append hp hq

theorem isLoop_append_rev {x : FinLatticeSites d N} {p q : List (PathStep d N)} (hp : IsLoop x p)
    (hq : IsLoop x q) : IsLoop x (p ++ pathRev q) := pathChain_append hp (pathChain_rev q hq)

/-- A lasso: go out along `c`, run the loop `q`, come back. -/
theorem isLoop_lasso {x y : FinLatticeSites d N} {c q : List (PathStep d N)} (hc : PathChain x c y)
    (hq : IsLoop y q) : IsLoop x (c ++ q ++ pathRev c) :=
  pathChain_append (pathChain_append hc hq) (pathChain_rev c hc)

/-! ## Products of Wilson loops -/

/-- **`W_p · W_q = W_{pq} + W_{p q̄}`** for SU(2) (any two paths; for loops at one site both terms are loops). -/
theorem wilsonLoop_mul (p q : List (PathStep d N)) (U : GaugeConnection SU2 d N) :
    wilsonLoop 2 p U * wilsonLoop 2 q U = wilsonLoop 2 (p ++ q) U + wilsonLoop 2 (p ++ pathRev q) U := by
  simp only [wilsonLoop, pathHol_append, pathHol_rev]
  exact su2_mandelstam _ _

/-- The doubly traversed loop: `W_{pp} = W_p² − 2`. -/
theorem wilsonLoop_double (p : List (PathStep d N)) (U : GaugeConnection SU2 d N) :
    wilsonLoop 2 (p ++ p) U = wilsonLoop 2 p U ^ 2 - 2 := by
  have h := wilsonLoop_mul p p U
  have h2 : wilsonLoop 2 (p ++ pathRev p) U = 2 := by
    simp only [wilsonLoop, pathHol_append, pathHol_rev, mul_inv_cancel, su2_reTr_one]
  rw [h2] at h
  linarith

/-- **Lasso:** a loop `q` at `y`, conjugated by a path `c` from `x` to `y`, has the same Wilson loop. -/
theorem wilsonLoop_lasso (c q : List (PathStep d N)) (U : GaugeConnection SU2 d N) :
    wilsonLoop 2 (c ++ q ++ pathRev c) U = wilsonLoop 2 q U := by
  simp only [wilsonLoop, pathHol_append, pathHol_rev]
  exact gaugeReTr_conj _ _

/-! ## The loop algebra -/

/-- The Wilson loops based at `x`. -/
def loopSet (x : FinLatticeSites d N) : Set (GaugeConnection SU2 d N → ℝ) :=
  {f | ∃ p, IsLoop x p ∧ f = wilsonLoop 2 p}

/-- Their linear span. -/
def loopSpan (x : FinLatticeSites d N) : Submodule ℝ (GaugeConnection SU2 d N → ℝ) := Submodule.span ℝ (loopSet x)

/-- A loop based at `y`, reached from `x`, is (as a function) a loop based at `x`. -/
theorem mem_loopSet_of_lasso {x y : FinLatticeSites d N} {c q : List (PathStep d N)} (hc : PathChain x c y)
    (hq : IsLoop y q) : wilsonLoop 2 q ∈ loopSet x :=
  ⟨c ++ q ++ pathRev c, isLoop_lasso hc hq, funext fun U => (wilsonLoop_lasso c q U).symm⟩

theorem one_mem_loopSpan (x : FinLatticeSites d N) : (1 : GaugeConnection SU2 d N → ℝ) ∈ loopSpan x := by
  have h : wilsonLoop 2 ([] : List (PathStep d N)) ∈ loopSet x := ⟨[], rfl, rfl⟩
  have e : (1 : GaugeConnection SU2 d N → ℝ) = (1 / 2 : ℝ) • wilsonLoop 2 ([] : List (PathStep d N)) := by
    funext U
    simp [wilsonLoop, pathHol, su2_reTr_one]
  rw [e]
  exact Submodule.smul_mem _ _ (Submodule.subset_span h)

/-- **Products stay in the span (SU(2)).** -/
theorem mul_mem_loopSpan {x : FinLatticeSites d N} {f g : GaugeConnection SU2 d N → ℝ} (hf : f ∈ loopSpan x)
    (hg : g ∈ loopSpan x) : f * g ∈ loopSpan x := by
  -- first for a single loop `f = W_p`
  have key : ∀ p, IsLoop x p → ∀ g, g ∈ loopSpan x → wilsonLoop 2 p * g ∈ loopSpan x := by
    intro p hp g hg
    induction hg using Submodule.span_induction with
    | mem g hg =>
      obtain ⟨q, hq, rfl⟩ := hg
      have e : wilsonLoop 2 p * wilsonLoop 2 q = wilsonLoop 2 (p ++ q) + wilsonLoop 2 (p ++ pathRev q) :=
        funext fun U => wilsonLoop_mul p q U
      rw [e]
      exact add_mem (Submodule.subset_span ⟨_, isLoop_append hp hq, rfl⟩)
        (Submodule.subset_span ⟨_, isLoop_append_rev hp hq, rfl⟩)
    | zero => simp
    | add g₁ g₂ _ _ h₁ h₂ => rw [mul_add]; exact add_mem h₁ h₂
    | smul c g _ h => rw [mul_smul_comm]; exact Submodule.smul_mem _ c h
  induction hf using Submodule.span_induction with
  | mem f hf => obtain ⟨p, hp, rfl⟩ := hf; exact key p hp g hg
  | zero => simp
  | add f₁ f₂ _ _ h₁ h₂ => rw [add_mul]; exact add_mem h₁ h₂
  | smul c f _ h => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c h

/-- **The SU(2) loop algebra at `x`**: the linear span of the Wilson loops based at `x` is a subalgebra of the
functions of the field (it contains `1` and is closed under products). -/
def loopAlgebra (x : FinLatticeSites d N) : Subalgebra ℝ (GaugeConnection SU2 d N → ℝ) :=
  (loopSpan x).toSubalgebra (one_mem_loopSpan x) (fun _ _ hf hg => mul_mem_loopSpan hf hg)

/-- The algebra generated by single loops is just their linear span: no products of loops are needed (SU(2)). -/
theorem loopAlgebra_coe (x : FinLatticeSites d N) : (loopAlgebra x : Set (GaugeConnection SU2 d N → ℝ)) = loopSpan x :=
  rfl

theorem loopSet_subset_loopAlgebra (x : FinLatticeSites d N) : loopSet x ⊆ loopAlgebra x :=
  fun _ hf => Submodule.subset_span hf

/-- **Every element of the loop algebra is gauge invariant.** -/
theorem gauge_of_mem_loopAlgebra {x : FinLatticeSites d N} {f : GaugeConnection SU2 d N → ℝ}
    (hf : f ∈ loopAlgebra x) (g : GaugeTransform SU2 d N) (U : GaugeConnection SU2 d N) :
    f (gaugeTransformConnection g U) = f U := by
  change f ∈ loopSpan x at hf
  induction hf using Submodule.span_induction with
  | mem f hf => obtain ⟨p, hp, rfl⟩ := hf; exact wilsonLoop_gauge x p hp g U
  | zero => rfl
  | add f₁ f₂ _ _ h₁ h₂ => simp [h₁, h₂]
  | smul c f _ h => simp [h]

end ProofPhase.SectorS
